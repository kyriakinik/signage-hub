# ==========================================
# 1. PYTHON / DJANGO
# ==========================================
# Εικονικό περιβάλλον (ποτέ δεν ανεβαίνει στο Git)
venv/
.venv/
env/

# Python compiled bytecode (δημιουργείται αυτόματα κατά την εκτέλεση)
__pycache__/
*.py[cod]
*$py.class

# Βάση δεδομένων SQLite
# (Στο Git ανεβάζουμε τα migrations, ΟΧΙ το ίδιο το αρχείο της βάσης δεδομένων)
*.sqlite3
db.sqlite3

# Αρχεία μεταβλητών περιβάλλοντος / API keys
.env
.env.local

# ==========================================
# 2. REACT / NODE (FRONTEND)
# ==========================================
# Φάκελος εξαρτήσεων (εγκαθίσταται μέσω npm install)
node_modules/
frontend/node_modules/

# Production build output
dist/
frontend/dist/
build/

# Logs σφαλμάτων του npm
npm-debug.log*
yarn-debug.log*

# ==========================================
# 3. ΛΕΙΤΟΥΡΓΙΚΟ & EDITORS (OS / IDEs)
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/